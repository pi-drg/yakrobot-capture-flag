pragma solidity 0.8.31;

import {Script} from "forge-std/Script.sol";

/// @notice Writes test/vectors.json: fixed Capture structs with their EIP-712 hashes and
/// signatures. The contract, Worker and gateway tests all read this one file.
///
/// The hashing here is written out by hand, separately from CaptureFlag, so the contract
/// test checks one implementation against the other.
///
///   forge script script/Vectors.s.sol
contract Vectors is Script {
    // Test-only key, derived from a public string. Never fund it.
    uint256 constant KEY = uint256(keccak256("yakrobot-capture-flag vectors key"));

    string constant NAME = "yakrobot-capture-flag";
    string constant VERSION = "1";
    uint256 constant CHAIN_ID = 84532;

    bytes32 constant DOMAIN_TYPEHASH = keccak256(
        "EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)"
    );
    bytes32 constant CAPTURE_TYPEHASH =
        keccak256("Capture(bytes32 robotId,address player,uint256 nonce,uint256 deadline)");

    struct V {
        string robotKey;
        uint256 nonce;
        uint256 deadline;
    }

    function run() external {
        address verifyingContract =
            address(uint160(uint256(keccak256("yakrobot-capture-flag vectors contract"))));
        address player = vm.addr(KEY);
        bytes32 domainSeparator = keccak256(
            abi.encode(
                DOMAIN_TYPEHASH,
                keccak256(bytes(NAME)),
                keccak256(bytes(VERSION)),
                CHAIN_ID,
                verifyingContract
            )
        );

        V[3] memory vs = [
            V("gateway.yakrobot.example/picar_adeept", 0, 1_790_000_600),
            V("gateway.yakrobot.example/picar_freenove", 1, 1_790_000_600),
            V("other-gateway.example/picar_adeept", type(uint64).max, 1_800_000_000)
        ];

        string memory items;
        for (uint256 i; i < vs.length; i++) {
            bytes32 robotId = keccak256(bytes(vs[i].robotKey));
            bytes32 structHash = keccak256(
                abi.encode(CAPTURE_TYPEHASH, robotId, player, vs[i].nonce, vs[i].deadline)
            );
            bytes32 digest = keccak256(abi.encodePacked("\x19\x01", domainSeparator, structHash));
            (uint8 v, bytes32 r, bytes32 s) = vm.sign(KEY, digest);
            string memory item = string.concat(
                '{"robotKey":"',
                vs[i].robotKey,
                '","message":{"robotId":"',
                vm.toString(robotId),
                '","player":"',
                vm.toString(player),
                '","nonce":"',
                vm.toString(vs[i].nonce),
                '","deadline":"',
                vm.toString(vs[i].deadline),
                '"},"structHash":"',
                vm.toString(structHash),
                '","digest":"',
                vm.toString(digest),
                '","signature":"',
                vm.toString(abi.encodePacked(r, s, v)),
                '"}'
            );
            items = i == 0 ? item : string.concat(items, ",", item);
        }

        string memory json = string.concat(
            '{"_comment":"Generated by contracts/script/Vectors.s.sol. privateKey is test-only and public; never fund it. robotId = keccak256(robotKey).",',
            '"privateKey":"',
            vm.toString(bytes32(KEY)),
            '","signer":"',
            vm.toString(player),
            '","domain":{"name":"',
            NAME,
            '","version":"',
            VERSION,
            '","chainId":',
            vm.toString(CHAIN_ID),
            ',"verifyingContract":"',
            vm.toString(verifyingContract),
            '"},"domainSeparator":"',
            vm.toString(domainSeparator),
            '","primaryType":"Capture","types":{"EIP712Domain":[{"name":"name","type":"string"},{"name":"version","type":"string"},{"name":"chainId","type":"uint256"},{"name":"verifyingContract","type":"address"}],',
            '"Capture":[{"name":"robotId","type":"bytes32"},{"name":"player","type":"address"},{"name":"nonce","type":"uint256"},{"name":"deadline","type":"uint256"}]},',
            '"vectors":[',
            items,
            "]}"
        );
        vm.writeFile("test/vectors.json", json);
    }
}

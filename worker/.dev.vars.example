# Local dev secrets for `wrangler dev`. Never commit real values — in production these
# come from `wrangler secret put`, typed by the operator, never by an agent.

# The relayer's gas-only hot key. For local runs against anvil, use one of
# anvil's well-known dev keys; never a key that holds mainnet funds.
RELAYER_PRIVATE_KEY=

# JSON-RPC for CHAIN. The public endpoint is fine for the pilot; for an event, use a
# provider URL (it may embed an API key, which is why this is a secret, not a var).
RPC_URL=https://sepolia.base.org

# /admin is behind Cloudflare Access, which `wrangler dev` can't put in front, so it 401s
# locally (or 501s with CF_ACCESS_AUD blank). The tests cover it.

# Optional: a CDP Secret API Key (Ed25519) for /admin's faucet top-up, Base Sepolia only.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
